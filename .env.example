# RelayOps 环境变量模板
#
# 用法：
#   1. 复制到本文件同级的 .env（.env 已被 .gitignore 忽略，不会提交）
#        Copy-Item .env.example .env
#   2. 按需修改；application.yml 通过 spring.config.import 读取 .env
#   3. docker compose 也会读取同名 .env，用于 postgres / redis 的启动参数
#
# 约定：
#   * 变量全部有安全默认值，只有密钥类默认留空；
#   * 修改后重启应用生效（spring.quartz.* 与 datasource 不支持热更新）；
#   * 本文件由 ConfigurationReferenceTest 守护：application.yml 里出现的每个
#     ${VAR} 都必须能在这里找到，避免"配置漏进代码、文档漏掉变量"。

# ---------------------------------------------------------------------------
# 应用与运行时
# ---------------------------------------------------------------------------
RELAY_OPS_SERVER_PORT=8080
RELAY_OPS_SERVER_ADDRESS=0.0.0.0
# 控制台（Nginx 容器）对外端口
RELAY_OPS_WEB_PORT=8088
# 容器数据目录（相对 compose 文件；默认 ../data）
RELAY_OPS_DATA_DIR=../data
RELAY_OPS_APP_NAME=relay-ops-backend
RELAY_OPS_APP_TITLE=RelayOps
RELAY_OPS_APP_DESCRIPTION=Upstream API operations platform
# ---------------------------------------------------------------------------
# 部署形态：由配置决定，而不是无脑起全家桶
#   local-deps → 起自带的 postgres/redis
#   napcat     → 起 QQ 接入容器
#   留空则只起 app/web，数据库与 Redis 用外部的（需填下面的 DB_URL / REDIS_HOST）
# 也可以只开一个，例如 COMPOSE_PROFILES=napcat + 外部数据库。
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=local-deps,napcat

# ---------------------------------------------------------------------------
# 数据库与 Redis
# 用自带容器时保持默认（容器名 postgres / redis）；
# 用外部服务时改成容器可达地址，例如：
#   RELAY_OPS_DB_URL=jdbc:postgresql://host.docker.internal:5432/relay_ops
#   RELAY_OPS_REDIS_HOST=host.docker.internal
# ---------------------------------------------------------------------------
RELAY_OPS_DB_URL=jdbc:postgresql://postgres:5432/relay_ops
RELAY_OPS_REDIS_HOST=redis
RELAY_OPS_REDIS_PORT=6379

# 对外发布端口（生产覆盖里映射到宿主机，带密码才允许访问）
#   postgres: 15342 -> 5432（外部用 jdbc:postgresql://<ip>:15342/relay_ops + 用户名密码）
#   redis:    16379 -> 6379（外部用 redis-cli -h <ip> -p 16379 -a <密码>）
RELAY_OPS_DB_PUBLISH_PORT=15342
RELAY_OPS_REDIS_PUBLISH_PORT=16379

RELAY_OPS_TIMEZONE=Asia/Shanghai
RELAY_OPS_VIRTUAL_THREADS=true
RELAY_OPS_JACKSON_INCLUSION=non_null

# 容器内 JVM 参数（compose 的 app 服务使用）
RELAY_OPS_JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+UseG1GC

# ---------------------------------------------------------------------------
# 本地开发安全开关（生产必须保持 false）
# identity 尚未落地时，dev-open=true 会放行 /api/** 并允许下面的 CORS 来源，
# 便于用本地前端直接联调；启动日志会打印 WARN 提醒。
# ---------------------------------------------------------------------------
RELAY_OPS_DEV_OPEN_API=false

# 控制台默认管理员：首次启动且库中无账号时创建；密码留空则不创建（登录不可用）
RELAY_OPS_ADMIN_USERNAME=admin
RELAY_OPS_ADMIN_PASSWORD=
RELAY_OPS_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# HTTP 会话（Redis 存储）
# ---------------------------------------------------------------------------
RELAY_OPS_SESSION_TIMEOUT=8h
RELAY_OPS_SESSION_COOKIE_NAME=RELAY_OPS_SESSION
RELAY_OPS_SESSION_COOKIE_HTTP_ONLY=true
RELAY_OPS_SESSION_COOKIE_SAME_SITE=strict
RELAY_OPS_SESSION_COOKIE_SECURE=false
RELAY_OPS_SESSION_STORE=redis
RELAY_OPS_SESSION_NAMESPACE=relay-ops:session
RELAY_OPS_SESSION_FLUSH_MODE=on_save

# ---------------------------------------------------------------------------
# 主数据库（PostgreSQL + pgvector）
# 用自带容器时保持上面的 postgres:5432；用外部库时改成外部地址。
# DB_NAME/DB_PORT 只影响自带容器，DB_URL 才是应用实际连接的地址。
# ---------------------------------------------------------------------------
RELAY_OPS_DB_NAME=relay_ops
RELAY_OPS_DB_PORT=5432
RELAY_OPS_DB_USERNAME=relay_ops
RELAY_OPS_DB_PASSWORD=relay_ops
RELAY_OPS_DB_POOL_SIZE=12
RELAY_OPS_DB_POOL_MIN_IDLE=2
RELAY_OPS_DB_IDLE_TIMEOUT=120000
RELAY_OPS_DB_CONNECTION_TIMEOUT=5000
RELAY_OPS_DB_VALIDATION_TIMEOUT=3000
RELAY_OPS_DB_KEEPALIVE_TIME=60000
RELAY_OPS_DB_MAX_LIFETIME=300000

# ---------------------------------------------------------------------------
# Redis（地址与端口在上面的"部署形态"里统一定义，这里只放连接参数）
# ---------------------------------------------------------------------------
RELAY_OPS_REDIS_USERNAME=
RELAY_OPS_REDIS_PASSWORD=
RELAY_OPS_REDIS_DATABASE=0
RELAY_OPS_REDIS_TIMEOUT=3s

# ---------------------------------------------------------------------------
# 数据库迁移（Flyway）与 MyBatis
# ---------------------------------------------------------------------------
RELAY_OPS_FLYWAY_ENABLED=true
RELAY_OPS_FLYWAY_LOCATIONS=classpath:db/migration
RELAY_OPS_FLYWAY_VALIDATE_NAMING=true
RELAY_OPS_MAPPER_LOCATIONS=classpath*:/mapper/**/*.xml
RELAY_OPS_TYPE_HANDLERS_PACKAGE=com.relayops.infrastructure.persistence.mybatis.handler

# ---------------------------------------------------------------------------
# 调度（Quartz + 中国工作日历）
# ---------------------------------------------------------------------------
RELAY_OPS_SCHEDULING_ENABLED=true
RELAY_OPS_SCHEDULING_ZONE=Asia/Shanghai
RELAY_OPS_SCHEDULING_CALENDAR=cn-official
RELAY_OPS_SCHEDULING_THREADS=10
RELAY_OPS_SCHEDULING_EXECUTION_TIMEOUT=5m
RELAY_OPS_SCHEDULING_SILENT_GRACE=15m
RELAY_OPS_SCHEDULING_PREVIEW_COUNT=10
RELAY_OPS_SCHEDULING_SHIFT_HORIZON_DAYS=30
RELAY_OPS_QUARTZ_SCHEDULER_NAME=relay-ops
RELAY_OPS_QUARTZ_AUTO_STARTUP=true
RELAY_OPS_QUARTZ_WAIT_ON_SHUTDOWN=true
RELAY_OPS_QUARTZ_OVERWRITE_JOBS=false
RELAY_OPS_QUARTZ_INSTANCE_ID=AUTO
RELAY_OPS_QUARTZ_CLUSTERED=true
RELAY_OPS_QUARTZ_CLUSTER_CHECKIN_INTERVAL=15000
RELAY_OPS_QUARTZ_ACQUIRE_TRIGGERS_WITHIN_LOCK=true
RELAY_OPS_QUARTZ_MISFIRE_THRESHOLD=60000

# ---------------------------------------------------------------------------
# 上游采集：账号凭证的 AES-GCM 密钥（base64，16/24/32 字节）
# 生成：openssl rand -base64 32   或   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
# 留空时应用仍可启动，但保存账号凭证会报错（不会以明文落库）。
# ⚠ 更换密钥后，所有已存凭证都需要重新录入。
# ---------------------------------------------------------------------------
RELAY_OPS_CREDENTIAL_KEY=

# ---------------------------------------------------------------------------
# 监控读模型：超过该小时数未成功采集即视为沉默，进入异常账号列表
# ---------------------------------------------------------------------------
RELAY_OPS_MONITORING_STALE_HOURS=2

# ---------------------------------------------------------------------------
# 通知与告警
# 邮件未配置时（enabled=false 或缺 host/to），告警与播报只写日志，不影响主流程。
# ---------------------------------------------------------------------------
RELAY_OPS_MAIL_ENABLED=false
RELAY_OPS_MAIL_HOST=
RELAY_OPS_MAIL_PORT=587
RELAY_OPS_MAIL_USERNAME=
RELAY_OPS_MAIL_PASSWORD=
RELAY_OPS_MAIL_FROM=
RELAY_OPS_MAIL_TO=
RELAY_OPS_MAIL_START_TLS=true

# 余额低于该值告警（负数关闭余额告警）；同类告警冷却窗口；沉默判定小时数
RELAY_OPS_ALERT_BALANCE_THRESHOLD=10
RELAY_OPS_ALERT_COOLDOWN=6h
RELAY_OPS_ALERT_STALE_HOURS=2

# ---------------------------------------------------------------------------
# QQ 接入（OneBot v11 / NapCat）
# compose 里已带 napcat 服务；首次启动需扫码登录，随后在 NapCat WebUI 配置：
#   HTTP 服务端：0.0.0.0:3000（容器内固定，compose 映射到宿主机 127.0.0.1 ）
#   反向 HTTP 上报：http://host.docker.internal:8080/api/v1/integration/onebot
#                   Header: Authorization: Bearer <RELAY_OPS_ONEBOT_WEBHOOK_TOKEN>
# 后端与 napcat 都起来后，把 RELAY_OPS_ONEBOT_ENABLED 改成 true。
# ---------------------------------------------------------------------------
NAPCAT_ACCOUNT=
NAPCAT_WEBUI_TOKEN=
NAPCAT_WEBUI_PORT=6099
NAPCAT_HTTP_PORT=3000

RELAY_OPS_ONEBOT_ENABLED=false
RELAY_OPS_ONEBOT_WEBHOOK_TOKEN=
RELAY_OPS_ONEBOT_API_BASE_URL=http://localhost:3000
RELAY_OPS_ONEBOT_API_TOKEN=
# 群白名单（逗号分隔，留空=不限制，正式部署建议显式配置）
RELAY_OPS_ONEBOT_ALLOWED_GROUPS=
# 这些 QQ 号在群里被当作管理员（可查平台数据）
RELAY_OPS_ONEBOT_ADMIN_USERS=
# 主动告警推送目标群（逗号分隔，留空则只发邮件）
RELAY_OPS_ONEBOT_ALERT_GROUPS=
RELAY_OPS_ONEBOT_REQUIRE_MENTION=true
# 长消息分片：单条上限、最多几段、段间隔（QQ 有长度与频率限制）
RELAY_OPS_ONEBOT_MAX_MESSAGE_CHARS=1000
RELAY_OPS_ONEBOT_MAX_SEGMENTS=5
RELAY_OPS_ONEBOT_RETRY_MAX=1
RELAY_OPS_ONEBOT_SEND_INTERVAL=500ms
RELAY_OPS_ONEBOT_TIMEOUT=5s

# ---------------------------------------------------------------------------
# 可观测性
# ---------------------------------------------------------------------------
RELAY_OPS_ACTUATOR_ENDPOINTS=health,info,prometheus
RELAY_OPS_ACTUATOR_PROBES=true
RELAY_OPS_ACTUATOR_INFO_ENV=true
RELAY_OPS_LOG_LEVEL=INFO
RELAY_OPS_APP_LOG_LEVEL=INFO
RELAY_OPS_QUARTZ_LOG_LEVEL=WARN

# ---------------------------------------------------------------------------
# 聊天模型（OpenAI 兼容端点；留空即关闭自然语言能力，命令仍可用）
# 主模型与降级模型各一组；缺 base-url / api-key / model 任一项的槽位会被跳过。
# ---------------------------------------------------------------------------
RELAY_OPS_AI_CHAT_ENABLED=false
RELAY_OPS_AI_CHAT_MAX_TOKENS=1024
RELAY_OPS_AI_CHAT_FALLBACK_BASE_URL=
RELAY_OPS_AI_CHAT_FALLBACK_API_KEY=
RELAY_OPS_AI_CHAT_FALLBACK_MODEL=
RELAY_OPS_AI_CHAT_FALLBACK_TEMPERATURE=0.2
RELAY_OPS_AI_CHAT_FALLBACK_MAX_TOKENS=1024
SPRING_AI_MODEL_CHAT=none
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_BASE_URL=https://api.openai.com
SPRING_AI_OPENAI_MODEL=gpt-4o-mini
SPRING_AI_OPENAI_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# 向量化（阿里云百炼，OpenAI 兼容接口）
# 与语音能力共用同一个 DASHSCOPE_API_KEY。
# ---------------------------------------------------------------------------
BAILIAN_EMBEDDING_ENABLED=true
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_WORKSPACE_ID=
DASHSCOPE_API_KEY=
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_EMBEDDING_DIMENSIONS=1024
BAILIAN_EMBEDDING_BATCH_SIZE=16
BAILIAN_EMBEDDING_TIMEOUT=10s

# ---------------------------------------------------------------------------
# Sub2API 只读库（可选；关闭时相关查询直接返回"未启用"）
# ---------------------------------------------------------------------------
SUB2API_DB_ENABLED=false
SUB2API_DB_URL=
SUB2API_DB_USERNAME=
SUB2API_DB_PASSWORD=
SUB2API_DB_CONNECT_TIMEOUT=5s
SUB2API_DB_QUERY_TIMEOUT=30s
SUB2API_DB_REALTIME_QUERY_TIMEOUT=3s
SUB2API_DB_POOL_SIZE=2
SUB2API_DB_MIN_IDLE=1
SUB2API_DB_BATCH_SIZE=2000
SUB2API_DB_MAX_BATCHES_PER_RUN=20
SUB2API_DB_UNAVAILABLE_COOLDOWN=30s
SUB2API_DB_REALTIME_MAX_ROWS=500
