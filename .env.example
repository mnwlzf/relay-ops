# Runtime
RELAY_OPS_SERVER_PORT=8080
RELAY_OPS_SERVER_ADDRESS=0.0.0.0
RELAY_OPS_SESSION_COOKIE_SECURE=false

# PostgreSQL
RELAY_OPS_DB_URL=jdbc:postgresql://localhost:5432/relay_ops
RELAY_OPS_DB_USERNAME=relay_ops
RELAY_OPS_DB_PASSWORD=relay_ops
RELAY_OPS_DB_POOL_SIZE=12

# Redis
RELAY_OPS_REDIS_HOST=localhost
RELAY_OPS_REDIS_PORT=6379
RELAY_OPS_REDIS_USERNAME=
RELAY_OPS_REDIS_PASSWORD=

# AI assistant; leave disabled until a model is configured
SPRING_AI_MODEL_CHAT=none
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_BASE_URL=https://api.openai.com
SPRING_AI_OPENAI_MODEL=gpt-4o-mini

# Sub2API external read-only database
SUB2API_DB_ENABLED=false
SUB2API_DB_URL=
SUB2API_DB_USERNAME=
SUB2API_DB_PASSWORD=
SUB2API_DB_CONNECT_TIMEOUT=5s
SUB2API_DB_QUERY_TIMEOUT=30s
SUB2API_DB_REALTIME_QUERY_TIMEOUT=3s
SUB2API_DB_POOL_SIZE=2
SUB2API_DB_MIN_IDLE=1
SUB2API_DB_BATCH_SIZE=2000
SUB2API_DB_MAX_BATCHES_PER_RUN=20
SUB2API_DB_UNAVAILABLE_COOLDOWN=30s
SUB2API_DB_REALTIME_MAX_ROWS=500
